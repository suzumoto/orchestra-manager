# このファイルをコピーして .env という名前で保存し、値を実際のものに書き換えてから使ってください。
#   例: cp .env.example .env
# .env 自体は .gitignore 済みなので、トークンなどの秘密情報をコミットしてしまう心配はありません。

# Discord Developer Portal (https://discord.com/developers/applications) で
# 作成した Bot の「Bot」タブにあるトークン。
DISCORD_BOT_TOKEN=

# 出欠を記録する Google スプレッドシートの ID。
# シートを開いた URL の
#   https://docs.google.com/spreadsheets/d/【この部分】/edit
# に入っている文字列をコピーする。
SPREADSHEET_ID=

# 座席図（座席レイアウト）を作る Google スライドの ID。
# スライドを開いた URL の
#   https://docs.google.com/presentation/d/【この部分】/edit
# に入っている文字列をコピーする。
SLIDES_PRESENTATION_ID=
